#!/usr/bin/env php
<?php
/**
 * Test harness: serves ./test-harness with `php -S`, hits it with curl, and checks the honeypot
 * log.
 * Usage: ./test
 */

$root = __DIR__;
$logfile = "$root/honeypot/honeypot.log";
$port = 8089;

// We need to load the handler itself so we can generate known-valid and known-invalid signatures
require_once("$root/honeypot/index.php");

/**
 * Attempts to derive a non-127.0.0.1 IP address from which curl will be able to send test
 * requests, e.g. the host's LAN IP. This is hacky as hell, sorry in advance. The remaining tests
 * will still run if it fails, though.
 */
function lan_ip(){
  $iface = trim((string)
    shell_exec("route -n get default 2>/dev/null | awk '/interface:/{print \$2}'"));
  if($iface !== '') {
    // for macOS
    $ip = trim((string)
      shell_exec('ipconfig getifaddr ' . escapeshellarg($iface) . ' 2>/dev/null')
    );
    if($ip !== '') return $ip;
  }
  // for *nixes
  $ip = trim((string)
    shell_exec("hostname -I 2>/dev/null | awk '{print \$1}'")
  );
  return $ip !== '' ? $ip : null;
}

$loopback = '127.0.0.1';
$lan      = lan_ip();

/********** Run a server! **********/

$server = proc_open(
  ['php', '-S', "0.0.0.0:$port", '-t', "$root/test-harness"],
  [
    0 => ['file', '/dev/null', 'r'],
    1 => ['file', '/dev/null', 'w'],
    2 => ['file', '/dev/null', 'w']
  ],
  $pipes
);
register_shutdown_function(function() use ($server, $logfile) {
  proc_terminate($server);
  proc_close($server);
  @unlink($logfile);
});

for($i = 0; $i < 50; $i++) {
  if(@fsockopen($loopback, $port)) break;
  usleep(100000);
  if($i == 49) { fwrite(STDERR, "Server failed to start on port $port\n"); exit(2); }
}

/**
 * GET $path from the server using $host as the destination (which determines our source IP).
 * Returns the resulting body and status for examination.
 */
function request($host, $path){
  $url = "http://$host:" . $GLOBALS['port'] . $path;
  $out = shell_exec('curl -s -w "\n%{http_code}" ' . escapeshellarg($url));
  $pos = strrpos($out, "\n");
  return ['body' => substr($out, 0, $pos), 'status' => (int) substr($out, $pos + 1)];
}

/**
 * Requests / and extracts a valid honeypot token as-generated by the server.
 * Uses hacky preg_matching because I couldn't be bothered spinning up a DOM.
 */
function get_token($host){
  $res = request($host, '/');
  if(!preg_match('~/honeypot/index\.php\?([^"]+)"~', $res['body'], $m)) {
    fwrite(STDERR, "Could not find honeypot link in page from $host\n");
    exit(2);
  }
  return $m[1];
}

/**
 * Returns an array of logfile lines (i.e. honeypot hits).
 */
function log_lines(){
  global $logfile;
  return file_exists($logfile) ? file($logfile, FILE_IGNORE_NEW_LINES) : [];
}

// Count successes/failures
$passed = 0;
$failed = 0;

/**
 * Run one test: clears the log, calls $fn, and compares the resulting log's IPs and status.
 * $fn returns the HTTP status; $expected_ips is the list of IPs that should be in the log.
 */
function test($name, $expected_status, $expected_ips, $fn){
  global $logfile, $passed, $failed;
  @unlink($logfile);
  $status = $fn();
  $ips = array_map(fn($l) => trim(substr($l, strrpos($l, ' - ') + 3)), log_lines());
  $ok = ($status === $expected_status) && ($ips === $expected_ips);
  if($ok) {
    $passed++;
    echo "  ✅ ok   $name\n";
  } else {
    $failed++;
    echo "  ❌ FAIL $name\n";
    echo "        status: expected $expected_status, got $status\n";
    echo "        log:    expected [" . implode(', ', $expected_ips) . "]";
    echo               ", got [" . implode(', ', $ips) . "]\n";
  }
}

$hit = fn($host, $query) => request($host, '/honeypot/index.php' . ($query === '' ? '' : "?$query"))['status'];

// At this point I'm thinking I should've used PHPUnit. Ah well, in for a penny:
echo "Testing from $loopback" . ($lan ? " and $lan" : ' (no LAN IP found; skipping cross-IP tests)') . "\n";

foreach(array_filter([$loopback, $lan]) as $ip) {
  echo "\nSource IP $ip:\n";

  test('valid token is banned', 403, [$ip], fn() => $hit($ip, get_token($ip)));
  test('no token is not banned', 200, [], fn() => $hit($ip, ''));
  test('garbage token is not banned', 200, [], fn() => $hit($ip, 'hello'));
  test('malformed hex is not banned', 200, [], fn() => $hit($ip, time() . '-' . str_repeat('z', 64)));
  test('tampered signature is not banned', 200, [], function() use ($hit, $ip) {
    $t = get_token($ip);
    $t[-1] = $t[-1] === '0' ? '1' : '0';
    return $hit($ip, $t);
  });
  test('tampered timestamp is not banned', 200, [], function() use ($hit, $ip) {
    [$time, $sig] = explode('-', get_token($ip));
    return $hit($ip, ($time + 1) . "-$sig");
  });
  test('token just inside max age is banned', 403, [$ip], function() use ($hit, $ip) {
    $time = time() - HONEYPOT_MAX_AGE * 60 + 30;
    return $hit($ip, $time . '-' . honeypot_sign($ip, $time));
  });
  test('expired token is not banned', 200, [], function() use ($hit, $ip) {
    $time = time() - HONEYPOT_MAX_AGE * 60 - 30;
    return $hit($ip, $time . '-' . honeypot_sign($ip, $time));
  });
  test('far-future token is not banned', 200, [], function() use ($hit, $ip) {
    $time = time() + 3600;
    return $hit($ip, $time . '-' . honeypot_sign($ip, $time));
  });
  test('token is reusable within its lifetime', 403, [$ip, $ip], function() use ($hit, $ip) {
    $t = get_token($ip);
    $hit($ip, $t);
    return $hit($ip, $t);
  });
  test('X-Forwarded-For cannot spoof the IP', 403, [$ip], function() use ($ip) {
    $t = get_token($ip);
    $url = "http://$ip:" . $GLOBALS['port'] . "/honeypot/index.php?$t";
    return (int) shell_exec('curl -s -o /dev/null -w "%{http_code}" -H "X-Forwarded-For: 203.0.113.9" ' . escapeshellarg($url));
  });
}

if($lan) {
  echo "\nCross-IP (token issued to one address, used from another):\n";
  test("token from $loopback is rejected from $lan", 200, [], fn() => $hit($lan, get_token($loopback)));
  test("token from $lan is rejected from $loopback", 200, [], fn() => $hit($loopback, get_token($lan)));
}

echo "\n$passed passed, $failed failed\n";
exit($failed ? 1 : 0);
